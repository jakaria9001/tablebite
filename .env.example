# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tablebite?sslmode=disable
PORT=8080
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
MIGRATIONS_DIR=./migrations

# Seed/import
SEED_MENU_FILE=./seed/menu.json

# Notifications (Phase 1 integration points)
WHATSAPP_ENABLED=false
SMS_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
RESTAURANT_NOTIFICATION_PHONE=

# Customer OTP authentication
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=
OTP_SESSION_EXPIRY_HOURS=24
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_PHONE_RATE_LIMIT=5
OTP_IP_RATE_LIMIT=20
